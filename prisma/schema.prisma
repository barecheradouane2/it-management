generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DeviceType {
  UNITE
  ECRAN
  ONDULEUR
  IMPRIMANTE
  LAPTOP
  DATASHOW
  POINT_ACCES
  SWITCH
  HARD_DISK
  TONER
  BATTERIE
  FLASH_DISK
  ADAPTATEUR_WIFI
  HARD_DISK_EXTERN
}

enum DeviceCondition {
  NEUF
  EN_PANNE
  ANCIEN
}

enum DeviceState {
  en_Service
  Transfert 
  en_Stock
  
}

enum AssignmentCondition {
  NEUF
  EN_PANNE
  ANCIEN
}

enum Block {
  BLOCK_SDR
  BLOCK_DR
  SPACE_R
  SPACE_P
  BASE_DE_VIE
}

enum Service {
  RH
  BET
  IT
  QAQC
  SMI
  COMPTABLE
  FINANCE
  CND
  COST
  ENGINEERING
  GDS
  TOPO
  PLANNING
  HSE
  LOGISTIC
  ARCHIVES
  CONSTRUCTION
  DCC
  SAS
  OTHER
}

model Employee {
  id       Int      @id @default(autoincrement())
  fullname String
  function String?
  email    String?  @unique
  phone    String?
  service  Service?

  assignments Assignment[]
  consumptions Consumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Device {
  id           Int             @id @default(autoincrement())
  codeSarpi    String? 
  serialNumber String?         @unique
  type         DeviceType
  brand        String
  hostName      String?
  model        String?
  arrivalDate  DateTime?
  location     String?
  condition    DeviceCondition @default(NEUF)
  state        DeviceState     @default(en_Stock)
  note         String?
  qty          Int             @default(1)   

  assignments   Assignment[]
  transferItems TransferItem[]
  consumptions  Consumption[]
  networkDevice NetworkDevice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assignment {
  id Int @id @default(autoincrement())

  deviceId   Int
  employeeId Int

  
  block     Block?
  
  condition AssignmentCondition @default(NEUF)
  note      String?
  qty        Int @default(1)

  assignedAt DateTime  @default(now())
  returnedAt DateTime?

  device   Device   @relation(fields: [deviceId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
  @@index([employeeId])
  @@index([block])
}

enum MaterialNature {
  INVESTISSEMENT
  CONSOMMABLE
}

model Transfer {
  id Int @id @default(autoincrement())

  siteExpediteur String
  dateExpediteur DateTime

  siteDestinataire String
  dateDestinataire DateTime?

  nature MaterialNature

  note String?

  items TransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteExpediteur])
  @@index([siteDestinataire])
  @@index([dateExpediteur])
}

model TransferItem {
  id         Int @id @default(autoincrement())
  transferId Int
  deviceId   Int
  quantity   Int @default(1)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  device   Device   @relation(fields: [deviceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transferId, deviceId])
  @@index([transferId])
  @@index([deviceId])
}

enum SupplyRequestStatus {
  BROUILLON
  EN_ATTENTE
  APPROUVEE
  PARTIELLEMENT_APPROUVEE
  REJETEE
  LIVREE
}

model SupplyRequest {
  id            Int                 @id @default(autoincrement())
  requestNumber String              @unique
  purpose       String
  requestDate   DateTime            @default(now())
  desiredDeadline DateTime?
  status        SupplyRequestStatus @default(BROUILLON)
  note          String?

  items SupplyRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestDate])
  @@index([status])
}

model SupplyRequestItem {
  id                  Int      @id @default(autoincrement())
  supplyRequestId     Int
  designation         String
  referenceCode       String?
  unit                String
  requestedQuantity   Int
  approvedQuantity    Int?
  desiredAvailability DateTime?
  note                String?

  supplyRequest SupplyRequest @relation(fields: [supplyRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplyRequestId])
  @@index([designation])
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           Int      @id @default(autoincrement())
  fullname     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)

  consumptions Consumption[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Consumption {
  id          Int      @id @default(autoincrement())
  deviceId    Int
  employeeId  Int?     // The employee who received or used the consumable
  userId      Int?     // The system user/admin who recorded the operation
  quantity    Int      @default(1)
  note        String?

  consumedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  device      Device    @relation(fields: [deviceId], references: [id])
  employee    Employee? @relation(fields: [employeeId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@index([deviceId])
  @@index([employeeId])
  @@index([userId])
  @@index([consumedAt])
}

model NetworkDevice {
  id            Int      @id @default(autoincrement())

  deviceId      Int?     @unique
  device        Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  host          String?

  wifiSsid      String?
  wifiPassword  String?

  adminLogin    String?
  adminPassword String?

  note          String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([deviceId])
}